# Copy this file to .env.server on the server. Never commit .env.server.
#
# On the Penang Ubuntu server, both containers share estuary-db_default and
# the existing database container is named estuary-postgres.
DATABASE_URL="postgresql://estuary:change-me@estuary-postgres:5432/estuary?schema=public"
DIRECT_URL="postgresql://estuary:change-me@estuary-postgres:5432/estuary?schema=public"

# The URL users open in their browser.
NEXTAUTH_URL="http://server-address:3000"
ESTUARY_BASE_URL="http://server-address:3000"

# Generate a long random value for the real server.
NEXTAUTH_SECRET="change-me"

# These integrations are still placeholders in the current prototype.
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_SES_FROM_EMAIL="finance@example.com"
AWS_S3_BUCKET="estuary-local"

# Change only if port 3000 is already occupied on the server.
ESTUARY_PORT=3000
ESTUARY_DATABASE_NETWORK="estuary-db_default"

# Public Google Sheet template links. These are embedded in the browser bundle
# during `docker compose build`; do not place secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_PAYMENT_VOUCHER_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_TRAVEL_ALLOWANCE_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_CASH_ADVANCE_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_EXPENSE_CLAIM_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_INTERNET_COMMUTE_CLAIM_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_MEDICAL_CLAIM_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_MILEAGE_CLAIM_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_PD_CLAIM_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_TECH_CLAIM_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_CASH_ADVANCE_APPENDIX_A_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
NEXT_PUBLIC_CASH_ADVANCE_PARTICIPANT_ALLOWANCE_TEMPLATE_SHEET_URL="https://docs.google.com/spreadsheets/d/replace-me/edit"
