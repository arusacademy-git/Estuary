# Copy this file to .env.server on the server. Never commit .env.server.
#
# If PostgreSQL runs directly on the same Linux server, use
# host.docker.internal as the hostname. PostgreSQL must accept connections
# from Docker's bridge network.
DATABASE_URL="postgresql://estuary:change-me@host.docker.internal:5432/estuary?schema=public"
DIRECT_URL="postgresql://estuary:change-me@host.docker.internal:5432/estuary?schema=public"

# The URL users open in their browser.
NEXTAUTH_URL="http://server-address:3000"
ESTUARY_BASE_URL="http://server-address:3000"

# Generate a long random value for the real server.
NEXTAUTH_SECRET="change-me"

# These integrations are still placeholders in the current prototype.
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_SES_FROM_EMAIL="finance@example.com"
AWS_S3_BUCKET="estuary-local"

# Change only if port 3000 is already occupied on the server.
ESTUARY_PORT=3000
